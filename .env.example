# ---------------------------------------------------------------------------
# Minkébé — configuration
# ---------------------------------------------------------------------------
# PostgreSQL 14+ (drizzle-kit push pour créer les tables).
# Vide => l'application bascule sur un stockage mémoire (démo, non persistant).
DATABASE_URL=

# Jeton exigé par /api/admin (en-tête x-admin-token) et la page /admin.
ADMIN_TOKEN=change-me

# simulation : parcours de paiement simulé, aucun débit.
# live       : appelle réellement PayPal / Mobile Money.
PAYMENT_MODE=simulation

# URL publique du jeu (utilisée dans les paquets et le guide serveur).
NEXT_PUBLIC_GAME_URL=http://localhost:3000

# PayPal REST (mode live).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Mobile Money (Airtel / Moov Gabon) — passerelles opérateur.
MOBILE_MONEY_API_URL=
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_MERCHANT_ID=
